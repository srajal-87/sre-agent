# SRE Agent — Environment Variables
# Copy to .env and fill in your values: cp .env.example .env

# LLM provider: Claude on Amazon Bedrock, bearer-token auth.
# The token is SHORT-LIVED (an STS-backed key, typically ~12h) — a live run
# after it expires fails on auth, which looks like a client bug. Mint a fresh
# one before a rehearsal.
AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key-here
AWS_REGION=eu-north-1
# AGENT_MODEL=eu.anthropic.claude-sonnet-4-5-20250929-v1:0

# Supabase (Postgres) — use the Supavisor SESSION pooler on port 5432.
# Do NOT use db.<ref>.supabase.co:5432: it is IPv6-only on the free tier and is
# unreachable from Docker Desktop on Windows. Port 6543 is the *transaction*
# pooler, which would additionally require statement_cache_size=0 + NullPool.
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Agent tools. Both have working defaults for the compose network; override
# PROMETHEUS_URL to http://localhost:9090 when running a tool from the host.
# PROMETHEUS_URL=http://prometheus:9090
# COMPOSE_PROJECT=sre-agent

# LangSmith (agent tracing)
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=sre-agent
